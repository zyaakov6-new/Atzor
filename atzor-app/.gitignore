# Build output and caches. Regenerated by Gradle, never worth versioning.
build/
.gradle/
.cxx/
*.apk
*.aab
*.ap_
*.dex
*.class
local.properties
captures/
.externalNativeBuild/

# A stale zip snapshot from before this repo existed.
android.zip

# Signing material. Deliberately NOT in git: keystore.properties holds the
# signing passwords in plain text, and the keystore itself is irreplaceable.
# If it ever leaks, someone can sign builds that impersonate this app; if it is
# ever lost, this app can never be updated on Play again under this listing.
# Back it up out of band instead (see README).
keystore/
*.jks
*.keystore

# IDE noise
.idea/
*.iml
.DS_Store

# iOS
ios/**/xcuserdata/
ios/**/*.xcworkspace/xcuserdata/
ios/build/
