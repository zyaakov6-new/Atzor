    <!-- Guarded Settings screen notice -->
    <string name="notice_settings_guarded">המסך הזה נעול בזמן נעילה, כדי שלא תוכלו לכבות את עצור. שאר ההגדרות פתוחות, כולל Bluetooth ו-Wi-Fi.\nצריך באמת לצאת? החזיקו את כפתור החירום במסך הנעילה.</string>

    <!-- Strict mode confirmation -->
    <string name="strict_confirm_title">לפני שמדליקים</string>
    <string name="strict_confirm_body">בזמן נעילה לא תוכלו לכבות את עצור ולא להסיר אותו. היציאה המוקדמת היחידה היא שחרור חירום, שנפתח בלחיצה ארוכה של חמש שניות.\n\nשאר ההגדרות נשארות פתוחות, כולל Bluetooth ו-Wi-Fi. שימו לב שבחלק מהמכשירים החסימה לא מושלמת, אז זה מקשה על היציאה אבל לא מונע אותה לגמרי.</string>
