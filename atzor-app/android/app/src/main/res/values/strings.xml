    <string name="app_name">Atzor</string>
    <string name="accessibility_service_label">Atzor · App blocking</string>
    <string name="accessibility_service_description">Atzor uses the accessibility service only to know which app is open, so it can block what you chose while a lock is running. It does not read screen content, keystrokes or messages. Nothing is sent anywhere.</string>
    <string name="shortcut_hour_short">Lock for an hour</string>
    <string name="shortcut_hour_long">Lock for one hour</string>
    <string name="shortcut_key_short">Until tag/code</string>
    <string name="shortcut_key_long">Lock until you open it with a tag or code</string>
    <string name="widget_description">Atzor - quick lock and countdown</string>

    <!-- Onboarding -->
    <string name="onb_title">Willpower runs out.\nA vault does not.</string>
    <string name="onb_body">Most apps ask you to hold back at exactly the hardest moment. Atzor asks nothing of you, it simply does not let the app open. For that, Android needs the Accessibility permission, once.</string>
    <string name="onb_step_1">Tap the button below</string>
    <string name="onb_step_2">Find \"Atzor · App blocking\"</string>
    <string name="onb_step_3">Turn it on and confirm</string>
    <string name="onb_privacy">Privacy: Atzor sees only which app is open. Not content, not keystrokes, not messages. Nothing leaves your phone.</string>
    <string name="onb_open_settings">Open accessibility settings</string>
    <string name="onb_continue">Let\'s start</string>

